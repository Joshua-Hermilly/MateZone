<UserControl x:Class="MateZone.vue.panels.GroupeDiscussion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MateZone.vue.panels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Background="#2F3136" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- - - - - - - - - - - - -->
        <!--   TITRE du Groupe     -->
        <!-- - - - - - - - - - - - -->
        <Border Background="#36393F" Padding="10" Grid.Row="0">
            <TextBlock Text="{Binding NomGroupe}" 
                       FontSize="20" 
                       Foreground="LightGray" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </Border>

        <!-- - - - - - - - - - - - -->
        <!--   LstMessage          -->
        <!-- - - - - - - - - - - - -->
        <ScrollViewer Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Auto">

            <ListBox ItemsSource="{Binding LstMessage}" 
                     Background="Transparent" 
                     BorderThickness="0" 
                     Foreground="White" 
                     FontSize="14">
            </ListBox>
        </ScrollViewer>

        <!-- - - - - - - - - - - - -->
        <!--   Action (EnvoieMsg)  -->
        <!-- - - - - - - - - - - - -->
        <Border Background="#40444B" Padding="10" Grid.Row="2" HorizontalAlignment="Stretch">
            <DockPanel LastChildFill="True">
                
                <!-- Bouton Envoyer -->
                <Button Content="Envoyer" 
                        DockPanel.Dock="Right"
                        Width="80" 
                        Height="40" 
                        Margin="5" 
                        VerticalAlignment="Center" 
                        Click="BtnEnvoyer_Click"
                        Background="#5865F2" 
                        Foreground="White" 
                        FontWeight="Bold"/>
                
                <!-- TextBox saisie du message -->
                <TextBox x:Name="txtMessageSaisie" 
                         Height="40" 
                         Margin="5" 
                         FontSize="14" 
                         Foreground="White" 
                         Background="#2F3136" 
                         BorderBrush="#202225" />
                
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
