<UserControl x:Name="Connexion1" x:Class="MateZone.vue.panels.Connexion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MateZone.vue.panels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400">
    
    <UserControl.Background>
        <SolidColorBrush Color="#FF1E1E1E"/>
    </UserControl.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- - - - - - - - - - - - -->
        <!--   Titre               -->
        <!-- - - - - - - - - - - - -->
        <Label Content="Bienvenue !" 
               HorizontalAlignment="Center" 
               Margin="0,30,0,0" 
               VerticalAlignment="Top" 
               FontFamily="Cascadia Mono SemiBold" 
               FontSize="24" 
               Foreground="White"/>
        
        <Label Content="Ravis de vous revoir !" 
               HorizontalAlignment="Center" 
               Margin="0,65,0,0" 
               VerticalAlignment="Top" 
               FontFamily="Cascadia Mono" 
               FontSize="14" 
               Foreground="#FF8B8B8B"/>

        <!-- - - - - - - - - - - - -->
        <!--   Fomrulaire          -->
        <!-- - - - - - - - - - - - -->
        <StackPanel Grid.Row="1" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Width="300">
            
            <!-- - - - - - - - - - - - -->
            <!--   Psuedo              -->
            <!-- - - - - - - - - - - - -->
            <StackPanel Margin="0,0,0,20">
                
                <Label Content="PSEUDO" 
                       FontFamily="Cascadia Mono SemiBold" 
                       FontSize="11" 
                       Foreground="#FFB9BBBE" 
                       Padding="0,0,0,8"/>
                
                <TextBox x:Name="TxtPseudo" 
                        Height="40" 
                         Background="#FF2C2C2C" 
                         Foreground="White" 
                         BorderBrush="#FF1E1E1E" 
                         BorderThickness="1" 
                         Padding="10,0,0,0" 
                         VerticalContentAlignment="Center" 
                         FontSize="14"
                         FontFamily="Cascadia Mono"/>
                
            </StackPanel>

            <!-- - - - - - - - - - - - -->
            <!--   MDP                 -->
            <!-- - - - - - - - - - - - -->
            <StackPanel Margin="0,0,0,20">

                <Label Content="MOT DE PASSE" 
                       FontFamily="Cascadia Mono SemiBold" 
                       FontSize="11" 
                       Foreground="#FFB9BBBE" 
                       Padding="0,0,0,8"/>

                <PasswordBox x:Name="MotDePasse"
                             Height="40" 
                             Background="#FF2C2C2C" 
                             Foreground="White" 
                             BorderBrush="#FF1E1E1E" 
                             BorderThickness="1" 
                             Padding="10,0,0,0" 
                             VerticalContentAlignment="Center" 
                             FontSize="14"
                             FontFamily="Cascadia Mono"/>
            </StackPanel>

            <!-- - - - - - - - - - - - -->
            <!--   CONNEXION BTN       -->
            <!-- - - - - - - - - - - - -->
            <Button Content="Connexion" 
                    Height="44" 
                    FontFamily="Cascadia Mono SemiBold" 
                    FontSize="14" 
                    Foreground="White" 
                    Margin="0,0,0,10"
                    Click="BtnConnexion_Click">

                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFB71C1C" Offset="0"/>
                        <GradientStop Color="#FF8B0000" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                
            </Button>

            <!-- - - - - - - - - - - - -->
            <!--   INSCRIPTION LIEN    -->
            <!-- - - - - - - - - - - - -->
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Left" 
                        Margin="0,10,0,0">
                
                <TextBlock Text="Besoin d'un compte ? " 
                           Foreground="#FF8B8B8B" 
                           FontSize="12" 
                           FontFamily="Cascadia Mono"/>
                
                <Button Content="S'inscrire" 
                        Foreground="#FF00A8FC" 
                        Background="#FF1E1E1E"
                        FontSize="12" 
                        FontFamily="Cascadia Mono" 
                        Cursor="Hand"
                        Click="BtnSinscrire_Click"/>
            
            </StackPanel>
        
        </StackPanel>
    </Grid>
</UserControl>
